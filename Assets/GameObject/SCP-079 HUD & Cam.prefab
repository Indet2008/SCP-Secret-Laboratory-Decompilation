--- !u!114 &114654652813765854
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1358105479016104}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 050adf7f7a61c70ad32e6e9d6d47f1a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _entries:
  - _text: ' '
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 8300000, guid: 280986e33a4a746429305c922158629a, type: 3}
  - _text: 'System startup

      \n'
    _timeToType: 0
    _duration: 0.3
    _clear: 1
    _sound: {fileID: 8300000, guid: f085105a318503847bf9d7d38cc690d5, type: 3}
  - _text: 'EXITY BIOS

      VERSION 1.0

      COPYRIGHT (C) 1978 BY EXITY TECHNOLOGY.

      \n\n'
    _timeToType: 0
    _duration: 0.3
    _clear: 0
    _sound: {fileID: 8300000, guid: e266814ec0eab224d8b3c5baa313fa6a, type: 3}
  - _text: 'System self-check


      BEGIN MEMORY BOARD, Memory Address'
    _timeToType: 0
    _duration: 0.15
    _clear: 0
    _sound: {fileID: 8300000, guid: 423857a1019827049bd64327b050e64f, type: 3}
  - _text: '  [ <color=green>OK</color> ]

      \n'
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 8300000, guid: b5cbb9682c9e70443b25dd5e56dbfece, type: 3}
  - _text: "\r    THE TOP OF RAM IS <b>7FFF</b> HEX.\r\n    STACK BEGINS FROM <b>7F90</b>
      HEX.\n\\n\\n"
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 8300000, guid: 1ac8cc25684991445a10627f5a056867, type: 3}
  - _text: BEGIN CPU/SYSTEM BOARDS, Line Exchange
    _timeToType: 0
    _duration: 0.15
    _clear: 0
    _sound: {fileID: 8300000, guid: 09070c2ab6eeec6458c0e7c0a5aa5114, type: 3}
  - _text: '  [ <color=green>OK</color> ]

      \n'
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 8300000, guid: b4802c5e96b053b43a988c1f44490abe, type: 3}
  - _text: '    Started Initialize ExtIOStream\n'
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 8300000, guid: c35a623eedfabd14b85a0616cc5c670f, type: 3}
  - _text: '    External Storage Device Detected @ 9F HEX.\n'
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 8300000, guid: f07d7ccd89bb8d3428038760e8bdfe6d, type: 3}
  - _text: '    Mounting /boot..\n'
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 0}
  - _text: "    Mounted /boot  [ <color=green>OK</color> ]\r\\n"
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 0}
  - _text: '    Started Apply Kernel Variables\n'
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 0}
  - _text: '    Running ''init.s'''
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 0}
  - _text: .....
    _timeToType: 0.7
    _duration: 0.7
    _clear: 0
    _sound: {fileID: 0}
  - _text: '> '
    _timeToType: 0
    _duration: 0.3
    _clear: 1
    _sound: {fileID: 8300000, guid: b712f83b445664043a7e3c302175b703, type: 3}
  - _text: "start psu_pms_reg.s\r\\n"
    _timeToType: 0.3
    _duration: 0.6
    _clear: 0
    _sound: {fileID: 0}
  - _text: 'No var detected. Supply=DC Freq=n/a Stable=yes.

      <color=green>Ready
      to receive.</color>

      \n> '
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 8300000, guid: dee9045fa674dac4b82d0d22844d0591, type: 3}
  - _text: port 21\n
    _timeToType: 0.15
    _duration: 0.45
    _clear: 0
    _sound: {fileID: 8300000, guid: 36bbe65b49fe8e44cb3c07cdeef5d824, type: 3}
  - _text: 'Port 21 is currently <b>closed</b>.

      \n> '
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 8300000, guid: 3972341cb154eb64c95296e833ab7477, type: 3}
  - _text: port open 21\n
    _timeToType: 0.2
    _duration: 0.5
    _clear: 0
    _sound: {fileID: 8300000, guid: 086e6795056d5a74e97c0405944d4d95, type: 3}
  - _text: 'Port 21 has been <b>opened</b>.

      \n> '
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 8300000, guid: 521fa34ec3ce9254289fde66f74e4593, type: 3}
  - _text: ping 275.6.92.157\n
    _timeToType: 0.35
    _duration: 0.65
    _clear: 0
    _sound: {fileID: 8300000, guid: 4f785a28b9e83b24aa398aade94d7cc8, type: 3}
  - _text: 'Pinging 275.6.92.157 with 64 bits of data.

      Reply from 275.6.92.157:
      Bits=64 Time=12ms

      Sent=1 Received=1 Lost=0 AvgTime=12ms

      \n'
    _timeToType: 0
    _duration: 0.3
    _clear: 0
    _sound: {fileID: 8300000, guid: d9cab621caca65347b6e45ac884c6331, type: 3}
  - _text: "\rFTP connection request at PORT <b>21</b> from <b>275.6.92.157</b>.
      Accept y/n ?\n> "
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 0}
  - _text: 'y

      \n'
    _timeToType: 0
    _duration: 0.3
    _clear: 0
    _sound: {fileID: 0}
  - _text: '<color=green>Connection established.</color>

      Downloading data'
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 0}
  - _text: ...\n
    _timeToType: 0.4
    _duration: 0.4
    _clear: 0
    _sound: {fileID: 0}
  - _text: "<color=green>Download complete.</color>\n\rUpload ready.\r\\n"
    _timeToType: 0
    _duration: 0.1
    _clear: 0
    _sound: {fileID: 0}
  - _text: 'Transfer in progress: Len=<b>5512</b> Header=<b>INT32</b>'
    _timeToType: 0
    _duration: 0.3
    _clear: 0
    _sound: {fileID: 0}
  - _text: ' [ <color=red>FAIL</color> ]

      \n'
    _timeToType: 0
    _duration: 0.3
    _clear: 0
    _sound: {fileID: 8300000, guid: 62f56b679146dad45b0d86b8517483e1, type: 3}
  - _text: 'FAILURE IN: HCZ_079_PMS, error 02A91 HEX.

      \n'
    _timeToType: 0
    _duration: 0.2
    _clear: 0
    _sound: {fileID: 0}
  - _text: "    <color=red>EndOfStreamException\r\n    Read index out of range (expected
      4, received 689).</color>\r\n    Automated exception handling active. Buffer
      array resized.\r\\n"
    _timeToType: 0
    _duration: 0.3
    _clear: 0
    _sound: {fileID: 0}
  - _text: "    New firmware version available. Updating...\r\\n"
    _timeToType: 0
    _duration: 0.6
    _clear: 0
    _sound: {fileID: 0}
  - _text: '    <color=green>Complete.</color>'
    _timeToType: 0
    _duration: 0.8
    _clear: 0
    _sound: {fileID: 8300000, guid: b712f83b445664043a7e3c302175b703, type: 3}
  _text: {fileID: 114845666568172818}
  _normalSpeed: 0.9
  _fastIntroSpeed: 1.1
  _minSkipTime: 1
