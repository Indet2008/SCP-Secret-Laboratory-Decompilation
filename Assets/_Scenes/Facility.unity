  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“They’re terrifying. Sometimes I stay up at night, asking myself if I made the right choice. Questioning my decision to listen to my instincts and to abandon them. Constantly wondering if the voices I heard were genuine chatter amongst the staff or just another imitation from that damn thing.\r\nI can still hear the cries, the shrieks of terror that followed in the distance. I didn’t know; no one did. It wasn’t my fault! How was I supposed to know? You would have done the same thing!”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
