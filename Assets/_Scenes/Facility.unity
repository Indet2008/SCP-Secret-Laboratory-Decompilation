      m_Calls: []
  m_text: "You stare at the mouse.\r\n\r\nThoughts of ARG 2 “Duality” fill your mind, an ARG that ran from the 15th October 2020 to the 3rd March 2021. While cut short, condemned to the darkness, we remember the brighter parts and thank everyone who participated.\r\n\r\nThe mouse begins to fade as you realize; you are the mouse.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c08702567d579a443be6a6222510669a, type: 2}
