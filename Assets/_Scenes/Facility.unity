  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“I just found out about Site-45. I can’t believe how much worse it’s getting out there. At least they don’t know where we are… I hope.\r\n\r\nI hate this place. I hate this place so much, but I’ll be damned if I’ve ever felt more secure anywhere else. To imagine that this place could be compromised too… Would that mean the end of us all? If they can find this place, maybe they can find… Oh God.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
