  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Epsilon-11? Hell if I know anything about them. They come in. They deal with the issues. They get out. They’re not ones to stop by for idle chit chat with the staff. Their existence remains a mystery. Their identities? Classified. Their complement of soldiers? Redacted. Their operations? Confidential. \r\n\r\nThey hide their numbers well though. They certainly have more soldiers than I originally thought.” \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
