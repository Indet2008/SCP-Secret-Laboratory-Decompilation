  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\rSCP-939 is able to sprint extremely fast for a short duration, allowing them to cover great distances and catch its prey. However, SCP-939 may only sprint for a short time, as indicated by a stamina bar. For every second SCP-939 was sprinting, its Ultrasensitive range will be reduced. \r\n___\r\n\r<i>\n“I was assigned to monitor security cameras during SCP-939’s first breach attempt at Site-02. I remember, in vivid detail, watching the researchers desperately attempt to run away. Not one of them made it to the hallway before it had caught them. All of them having their cranium forcibly destroyed. The screaming still haunts me.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
