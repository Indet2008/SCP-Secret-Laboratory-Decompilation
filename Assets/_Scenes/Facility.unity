  m_Name:
  m_EditorClassIdentifier:
  subtitles:
  - SubtitleTypeValue: 0
    SubtitleCategory: 1
    DefaultValue: Mobile Task Force Unit Epsilon-11 designated {0} has entered the facility.<split>All remaining personnel are advised to proceed with standard evacuation protocols until an MTF squad reaches your destination.<split>
    Duration: 15.5
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 1
    SubtitleCategory: 0
    DefaultValue: 'Awaiting re-containment of: {0} SCP subjects.'
    Duration: 5
    RequestSpace: 0
    Delay: 0
    ConvertNumbers: 1
  - SubtitleTypeValue: 2
    SubtitleCategory: 0
    DefaultValue: 'Awaiting re-containment of: 1 SCP subject.'
    Duration: 5
    RequestSpace: 0
    Delay: 0
    ConvertNumbers: 0
  - SubtitleTypeValue: 3
    SubtitleCategory: 0
    DefaultValue: Substantial threat to safety remains within the facility -- exercise caution.
    Duration: 6
    RequestSpace: 0
    Delay: 0
    ConvertNumbers: 0
  - SubtitleTypeValue: 4
    SubtitleCategory: 1
    DefaultValue: successfully terminated. Termination cause unspecified.
    Duration: 4
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 5
    SubtitleCategory: 1
    DefaultValue: terminated by SCP-{0}.
    Duration: 4.5
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 6
    SubtitleCategory: 1
    DefaultValue: successfully terminated by Automatic Security System.
    Duration: 4.5
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 7
    SubtitleCategory: 1
    DefaultValue: successfully terminated by Alpha Warhead.
    Duration: 4
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 8
    SubtitleCategory: 1
    DefaultValue: contained successfully by Science Personnel.
    Duration: 4
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 9
    SubtitleCategory: 1
    DefaultValue: contained successfully by Class-D Personnel.
    Duration: 4
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 10
    SubtitleCategory: 1
    DefaultValue: contained successfully by Chaos Insurgency.
    Duration: 4
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 11
    SubtitleCategory: 0
    DefaultValue: SCP-{0}
    Duration: 3
    RequestSpace: 1
    Delay: 0
    ConvertNumbers: 0
  - SubtitleTypeValue: 12
    SubtitleCategory: 1
    DefaultValue: contained successfully. Containment unit unknown.
    Duration: 5
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 13
    SubtitleCategory: 1
    DefaultValue: contained successfully. Containment Unit {0}.
    Duration: 5
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 14
    SubtitleCategory: 1
    DefaultValue: lost in Decontamination Sequence.
    Duration: 3
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 15
    SubtitleCategory: 1
    DefaultValue: '{0} out of {1} generators activated.'
    Duration: 4
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 1
  - SubtitleTypeValue: 16
    SubtitleCategory: 1
    DefaultValue: '<split>All generators have been successfully engaged.'
    Duration: 4.5
    RequestSpace: 0
    Delay: 0
    ConvertNumbers: 0
  - SubtitleTypeValue: 17
    SubtitleCategory: 1
    DefaultValue: Overcharge in 3... 2... 1...
    Duration: 4.5
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 18
    SubtitleCategory: 1
    DefaultValue: Facility is back in operational mode.
    Duration: 4
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 19
    SubtitleCategory: 2
    DefaultValue: Attention, all personnel.<split>The Light Containment Zone decontamination process will occur in T-15 minutes.<split>All biological substances must be removed in order to avoid destruction.
    Duration: 15
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 20
    SubtitleCategory: 2
    DefaultValue: Danger, Light Containment Zone overall decontamination in T-{0} minutes.
    Duration: 8
    RequestSpace: 0
    Delay: 2
    ConvertNumbers: 1
  - SubtitleTypeValue: 21
    SubtitleCategory: 2
    DefaultValue: Danger, Light Containment Zone overall decontamination in T-1 minute.
    Duration: 8
    RequestSpace: 0
    Delay: 2
    ConvertNumbers: 0
  - SubtitleTypeValue: 22
    SubtitleCategory: 2
    DefaultValue: Danger, Light Containment Zone overall decontamination in T-30 seconds.<split>All checkpoint doors have been permanently opened. Please evacuate immediately.
    Duration: 14
    RequestSpace: 0
    Delay: 2
    ConvertNumbers: 0
  - SubtitleTypeValue: 23
    SubtitleCategory: 2
    DefaultValue: Light Containment Zone is locked down and ready for decontamination.<split>The removal of organic substances has now begun.
    Duration: 8.5
    RequestSpace: 0
    Delay: 1.7
    ConvertNumbers: 0
  - SubtitleTypeValue: 24
    SubtitleCategory: 3
    DefaultValue: ALPHA WARHEAD EMERGENCY DETONATION SEQUENCE ENGAGED.<split>THE UNDERGROUND SECTION OF THE FACILITY WILL BE DETONATED IN T-{0} SECONDS.
    Duration: 11
    RequestSpace: 0
    Delay: 3
    ConvertNumbers: 1
  - SubtitleTypeValue: 25
    SubtitleCategory: 3
    DefaultValue: DETONATION CANCELLED. RESTARTING SYSTEMS.
    Duration: 4
    RequestSpace: 0
    Delay: 0
    ConvertNumbers: 0
  - SubtitleTypeValue: 26
    SubtitleCategory: 3
    DefaultValue: DETONATION SEQUENCE RESUMED, T-{0} SECONDS.
    Duration: 5
    RequestSpace: 0
    Delay: 3
    ConvertNumbers: 1
  - SubtitleTypeValue: 27
    SubtitleCategory: 1
    DefaultValue: terminated by Marshmallow Man.
    Duration: 4
    RequestSpace: 1
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 28
    SubtitleCategory: 1
    DefaultValue: Nine-Tailed Fox Backup Unit has entered the facility.<split>
    Duration: 5.5
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 29
    SubtitleCategory: 1
    DefaultValue: Attention, all personnel. Detected [number] Chaos Insurgency forces at Gate A.<split>Lethal force authorized.
    Duration: 12
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 30
    SubtitleCategory: 1
    DefaultValue: 'Acquired [number] additional hostile forces at Gate A.<split>Defense model: updated.'
    Duration: 7.2
    RequestSpace: 0
    Delay: 2.5
    ConvertNumbers: 0
  - SubtitleTypeValue: 31
    SubtitleCategory: 3
    DefaultValue: 'SITE RECOVERY FAILURE — DEAD MAN''s SWITCH ACTIVATED.<split>THE UNDERGROUND SECTION OF THIS FACILITY <b>WILL</b> SELF-DESTRUCT IN: T-[time] SECONDS'
    Duration: 15
    RequestSpace: 0
    Delay: 4
    ConvertNumbers: 1
  subtitleCategories:
  - {fileID: 17111}
  - {fileID: 17592}
  - {fileID: 19312}
