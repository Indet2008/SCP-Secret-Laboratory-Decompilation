  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Activate Charge to send SCP-096 lunging in the direction they’re facing, destroying all doors and damaging all players in their way. Activating Charge on a gate causes SCP-096 to forcefully pry them open and get through. \r\n___\r\n\r<i>\n“A common belief is that letting out your negative emotions relieves you of them. However, for the object, I can’t help but think that it only worsens its sorrow.” \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
