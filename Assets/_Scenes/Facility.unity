  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“It's just a bottle of Cola”, you told yourself as you drank it. \r\n\r\nYour first mistake was thinking they'd bring you into a fortified room just to drink Cola. The second was chugging the entire bottle without asking any questions. \r\n\r\nNow they're testing your endurance, and you don't even notice that you're still running the track after two hours."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
