  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A compact, 9mm, submachine gun, popular with several foundation task forces. With an integral recoil-reduction system and high fire rate, few firearms in foundation possession boast such widespread adoption.\r\nAn MTF operative will often not know the extent of a threat once they’re deployed. 40 rounds should be more than enough for any number of combat scenarios an MTF might enter. At least, that's what they are told.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
