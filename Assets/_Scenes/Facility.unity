  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"I was there when SCP-330 was first brought into Site-11. I was assigned as the Assistant Supervisor for its program. Somehow, I kept that position, even after all the relocations and crises, and eventually made my way up here.\r\n\r\nI’ve never been able to imagine what happened to those kids on that Halloween Eve.\r\nAnd I’ve always wondered where their hands disappeared to.\"\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
