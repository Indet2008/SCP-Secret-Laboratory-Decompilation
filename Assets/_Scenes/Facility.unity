  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '"I''m excited to hear that more attention is being placed on SCP-500. Though, it might put me on a run for my money. All jokes aside, I’m always glad to hear when something other than death might come out of this place."'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
