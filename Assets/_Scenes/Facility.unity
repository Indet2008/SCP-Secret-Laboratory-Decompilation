  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the event of a catastrophic site event, Class-D personnel are to be terminated immediately; unless deemed necessary by on-site security personnel. Termination of Class-D personnel is to be done promptly to prevent unwanted intervention that would necessitate any further actions that could complicate an ongoing event.\n\n\nIf Class-D personnel are found armed with ballistic, blunt, and/or anomalous weaponry the priority response is to immediately terminate the Class-D subject, with no exception.\n\n\nIf Class-D personnel are found exploiting SCP objects, their operating number should be reprimanded and the subject should be terminated with no exception.\n\n\nIf Class-D personnel are found attempting to flee the facility, and by extension risk a major breach of security, the Class-D subject should be immediately terminated with no exception.\n\n\nIf Class-D personnel are found aiding higher-class site personnel, the higher rank personnel is to be reprimanded for failure to abide by Class-D termination protocol. The Class-D subject is to be terminated with no exception.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
