  m_Name:
  m_EditorClassIdentifier:
  <StoredInfo>k__BackingField:
  - Key: {fileID: 2265}
    Text: Changes the Opacity of the <color=#FF574F>Remote Admin</color> menu.
  - Key: {fileID: 564}
    Text: Changes the Color Modifier of the <color=#FF574F>Remote Admin</color> menu.
  - Key: {fileID: 2130}
    Text: Changes the time it takes for a tooltip to popup.
  - Key: {fileID: 3852}
    Text: Changes the time it takes for a tooltip to disappear.
  - Key: {fileID: 2292}
    Text: "How often Network Messages will be sent.\n\nExample: <color=#7CFD3F>Round & Event's</color> tokens & timer will be affected by this setting."
  - Key: {fileID: 604}
    Text: Toggles whether tooltips will be shown.
  - Key: {fileID: 3445}
    Text: Toggles whether to display command suggestions in the <color=#FF574F>Text-Based Remote Admin</color> console.
  - Key: {fileID: 444}
    Text: Toggles whether to display timestamps in the <color=#FF574F>Text-Based Remote Admin</color> console.
  - Key: {fileID: 3306}
    Text: Toggles whether you will be able to move while inside the <color=#FF574F>Remote Admin</color> menu.
  - Key: {fileID: 193}
    Text: Saves your current settings, so that they are applied across all other sessions.
  - Key: {fileID: 3142}
    Text: "Resets your settings to their default values.\n\n<color=red>REMINDER:</color> You still have to hit \"Save\" if you wish to revert to the default settings."
  - Key: {fileID: 1470}
    Text: Undoes any changes done during the current session.
  <Manager>k__BackingField: {fileID: 17570}
