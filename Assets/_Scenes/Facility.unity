  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The sound of hundreds, perhaps thousands, of gears turning could be heard from the anomalous contraption. Whatever you placed in its input, you know for sure will not be the same once those metal doors slide open. Ten seconds is all you need. You’re forced to wonder how the machine works. \r\n\r\nSeven seconds. Is it sentient? How does it determine an object’s transfiguration? \r\nFour seconds. How did they even transport this thing on-site?\r\nOne second. You realize, none of that really matters now.\r\n\r\nThe doors slide open.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
