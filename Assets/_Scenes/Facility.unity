  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Designated as <i>Project: Segmentum</i> in Foundation registries, the newest prototype by Site-02’s Advanced Weapons department is the Micro H.I.D., designed to efficiently terminate most anomalies through intense electrical discharge. The Micro H.I.D. features two firing modes: a quick burst of electricity, and a charged-up beam with a longer start-up, but higher damage.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
