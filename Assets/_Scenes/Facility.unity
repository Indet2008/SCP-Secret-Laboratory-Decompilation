  m_Script: {fileID: 11500000, guid: 8dfdde47d603348c3e4530d5f8b3e160, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  <DefaultFormat>k__BackingField: '{0} {1} {2}'
  <Options>k__BackingField: []
  <InputFieldText>k__BackingField: {fileID: 0}
  <StoredInfo>k__BackingField:
  - Key: {fileID: 2895}
    Text: "Forces the round to start.\n<i><color=#9D9D9D>Only works while in lobby.</color></i>"
  - Key: {fileID: 2160}
    Text: Forces the round to restart.
  - Key: {fileID: 4547}
    Text: Stops all win conditions from ever being met.
  - Key: {fileID: 4752}
    Text: "Stops the round from ever starting.\n<i><color=#9D9D9D>Only works while in lobby.</color></i>"
  - Key: {fileID: 4443}
    Text: Forces the <color=#FF4435>Alpha Warhead</color> procedure to begin.
  - Key: {fileID: 4894}
    Text: Forces the <color=#FF4435>Alpha Warhead</color> procedure to stop.
  - Key: {fileID: 612}
    Text: Prohibits everyone from starting the <color=#FF4435>Alpha Warhead</color> procedure.
  - Key: {fileID: 1949}
    Text: "Forces the <color=#FF4435>Alpha Warhead</color> procedure to expedite to its end.\nThis will quickly destroy the interior of the facility."
  - Key: {fileID: 4732}
    Text: Forces Light Containment's <color=#40FF64>Decontamination</color> procedure to begin.
  - Key: {fileID: 1812}
    Text: Toggles <color=yellow>Friendly Fire</color> on & off.
  - Key: {fileID: 1268}
    Text: Toggles <color=yellow>Spawn Protection</color> on & off.
  - Key: {fileID: 1911}
    Text: '<color=green>Allows</color> Light Containment''s <color=#40FF64>Decontamination</color> process to start.'
  - Key: {fileID: 1448}
    Text: '<color=red>Blocks</color> Light Containment''s <color=#40FF64>Decontamination</color> from starting.'
  <TooltipManager>k__BackingField: {fileID: 17570}
