  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Perhaps a more unique feature of this SCP is how innocent it appears. A mere bottle of Cola. What’s the worst that could happen?\r\n\r\nThe Class-D we tested on soon found out. They were bouncing off the walls like they never had caffeine a day in their lives. I’m not the type of person to find humor in such situations, but even I have to admit that it was quite comical...\r\n\r\nWhat was less comical, was seeing them lined up in the on-site morgue due to heart failure a few days later.\"\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
