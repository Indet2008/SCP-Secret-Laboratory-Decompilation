  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "SCP-096 leans against a flat surface, suppressing the urge to cry. It gradually grows quieter until becoming nearly silent, regaining Hume Shield at a higher rate in the process. \r\n\r\n___\r\n<i>\n“My analysis has led me to conclude that SCP-096 possesses a child-like psychological state, acting purely on its desires and emotions. It doesn't have the cognitive ability to process how it feels. Though, of course, prior analysis is purely conjecture. How are we to understand something as bizarre as this with human psychology?”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
