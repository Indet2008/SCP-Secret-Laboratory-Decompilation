  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Insurgency’s standard issue rifle, an automatic weapon chambered in 7.62x39. It comes from a long lineage of Russian-born rifles. The AK has served worldwide for decades. \r\n\r\nFor the Insurgency, the rifle is seen in the hands of its most elite forces. Squads specifically trained to infiltrate sites will often be armed with the rifle. It seems that the AK’s stellar reputation precedes itself.\r\n\r\nThe Insurgency seems to have taken their own liberties with the design but these accessories are just decorations atop the rifle’s rugged Russian core.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
