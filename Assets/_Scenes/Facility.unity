  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“I can say with absolute confidence that this computer is highly intelligent. It seems to have the attention span of a six-year-old. No piece of metal has ever spoken to me quite as disrespectfully. \r\nI’d like to highlight that this SCP seems to adapt with ease and responds remarkably fast to all manner of threats. Unfortunately, in this facility, that is nothing to praise. \r\n\r\nI will soon be requesting a review of its containment. All personnel that come into contact with SCP-079 must have an audio recorder on their person; effective immediately. \r\nThe ignorance I’ve seen towards this thing is outstanding. You may be able to contain its body, but that does not mean you can ignore its influence on potential containment disasters.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
