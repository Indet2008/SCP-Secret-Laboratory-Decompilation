  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: “The Parang of Indonesia are beautiful blades that carry with them a strong sense of history, pride, and culture from a time before the light of Allah graced the Indonesian archipelago. They are passed down from generation to generation; a rite of passage for young adults in the region. This particular blade, however, embodies their history more strongly than any other of its kind! A minor cut placed upon the human body will wreak a plague of ants, and a major wound will result in the sacrifice of the lacerated individual’s life for the resurrection of another they once knew; a concept most forbidden, as there is no other resurrection but Yawm al-qiyāmah. Astaghfirullah, we have handed off this cursed item to the SCP Foundation for safekeeping and further research.”
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
