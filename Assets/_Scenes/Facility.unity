--- !u!114 &16334
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 33}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4277a1449335bd7149454e2887936028, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  <DefaultFormat>k__BackingField: '{0} {1} {2} {3}'
  <Options>k__BackingField: []
  <InputFieldText>k__BackingField: {fileID: 16719}
  <StoredInfo>k__BackingField:
  - Key: {fileID: 250}
    Text: Teleports you to the <color=#7CC0F5>selected</color> player.
  - Key: {fileID: 323}
    Text: Teleports the <color=#7CC0F5>selected</color> player to you.
  - Key: {fileID: 2799}
    Text: "Enables NOCLIP mode on the <color=#7CC0F5>selected</color> player.\n\n<color=#AAAAAA>The player must still press their NOCLIP key. (ALT by Default)</color>"
  - Key: {fileID: 2192}
    Text: Disables NOCLIP mode on the <color=#7CC0F5>selected</color> player.
  - Key: {fileID: 3521}
    Text: Enables GOD mode on the <color=#7CC0F5>selected</color> player.
  - Key: {fileID: 4576}
    Text: Disables GOD mode on the <color=#7CC0F5>selected</color> player.
  - Key: {fileID: 1116}
    Text: Heal the <color=#7CC0F5>selected</color> player based on the amount set above.
  - Key: {fileID: 3216}
    Text: Set the <color=#7CC0F5>selected</color> player's health to the amount set above.
  - Key: {fileID: 3563}
    Text: Enables BYPASS mode on the <color=#7CC0F5>selected</color> player.
  - Key: {fileID: 2351}
    Text: Disables BYPASS mode on the <color=#7CC0F5>selected</color> player.
  - Key: {fileID: 4902}
    Text: Toggles Global Intercom channel for the specified player(s).
  - Key: {fileID: 3519}
    Text: Times out the Intercom system if it's currently in use.
  - Key: {fileID: 4396}
    Text: Resets the timer on the Intercom to ready-to-speak.
  - Key: {fileID: 3821}
    Text: Sets maximum player's health.
  - Key: {fileID: 4298}
    Text: Resets maximum player's health.
  <TooltipManager>k__BackingField: {fileID: 17570}
