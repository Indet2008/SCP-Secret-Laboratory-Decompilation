  m_Name:
  m_EditorClassIdentifier:
  <DefaultFormat>k__BackingField: '{0} {3}'
  <Options>k__BackingField: []
  <InputFieldText>k__BackingField: {fileID: 19322}
  <StoredInfo>k__BackingField:
  - Key: {fileID: 1263}
    Text: Main page.
  - Key: {fileID: 3269}
    Text: Previous page.
  - Key: {fileID: 4740}
    Text: Next page.
  - Key: {fileID: 721}
    Text: "Clears your input\nfor ease of use."
  - Key: {fileID: 4854}
    Text: "<color=#86DCFF>C.A.S.S.I.E</color> will broadcast your message\nwithout the alarm at the beginning."
  - Key: {fileID: 3874}
    Text: "<color=#86DCFF>C.A.S.S.I.E</color> will broadcast your message\nwith the alarm at the beginning of the broadcast."
  - Key: {fileID: 2738}
    Text: "Forces <color=#86DCFF>C.A.S.S.I.E</color> to stop any messages\nit currently might be broadcasting."
  - Key: {fileID: 4091}
    Text: Copies the input into your clipboard.
  - Key: {fileID: 1205}
    Text: Plays the announcement only on your client.
  - Key: {fileID: 4382}
    Text: Applies the chosen value to the input field.
  - Key: {fileID: 4425}
    Text: Applies the chosen value to the input field.
  - Key: {fileID: 1075}
    Text: Applies the chosen value to the input field.
  - Key: {fileID: 1945}
    Text: This effect changes the <color=#E9F19E>pitch</color> of <color=#86DCFF>C.A.S.S.I.E's</color> voice.
  - Key: {fileID: 2345}
    Text: "<color=#E9F19E>Jam</color> causes <color=#86DCFF>C.A.S.S.I.E</color> to stutter based on the given values.\n\nThis adds a small delay to the effect."
  - Key: {fileID: 384}
    Text: "<color=#E9F19E>Jam</color> causes <color=#86DCFF>C.A.S.S.I.E</color> to stutter based on the given values.\n\nThis decides the stutter amount of the effect."
  - Key: {fileID: 3172}
    Text: "<color=#E9F19E>Yield</color> adds a small pause between this variable\nand the next word in the input."
  - Key: {fileID: 2261}
    Text: "<color=#E9F19E>Jam</color> causes <color=#86DCFF>C.A.S.S.I.E</color> to stutter based on the given values.\n\nThis adds a small delay to the effect."
  - Key: {fileID: 3187}
    Text: "<color=#E9F19E>Jam</color> causes <color=#86DCFF>C.A.S.S.I.E</color> to stutter based on the given values.\n\nThis decides the stutter amount of the effect."
  - Key: {fileID: 1099}
    Text: This effect changes the <color=#E9F19E>pitch</color> of <color=#86DCFF>C.A.S.S.I.E's</color> voice.
  - Key: {fileID: 1241}
    Text: "<color=#E9F19E>Yield</color> adds a small pause between this variable\nand the next word in the input."
