  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Your mind is filled with the effigies of those long since passed. Your nose begins to run, leaking bloody gray drippings. \r\n\r\nAs your mind leaves your body, you forget who you are. Lost memories are replaced with asking yourself and those you love the same questions: ‘Where are you?’, ‘What were you doing?’, ‘Who’s that behind you? In the end, all you could accomplish was collecting several glasses of water you could not remember. \r\n\r\nOnce again, you ask the spirits if they ever loved you at all.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
