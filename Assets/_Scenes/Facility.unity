  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Light Containment and Testing Zone, colloquially known by Site Staff as the ‘Grayhall’, houses multiple testing facilities and containment cells for a number of Euclid and Safe-Anomalous objects. \r\n\r\nThe Zone houses the majority of the D-Class stocks contained within numerous individual confinement cells and personnel offices. \r\nMedical testing, screening, and Site operations are also conducted here on both staff and D-Class Personnel."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
