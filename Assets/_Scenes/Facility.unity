  m_Name:
  m_EditorClassIdentifier:
  <DefaultFormat>k__BackingField: '{0} {2}'
  <Options>k__BackingField:
  - {fileID: 18469}
  - {fileID: 17578}
  - {fileID: 17051}
  - {fileID: 19701}
  <InputFieldText>k__BackingField: {fileID: 18907}
  <StoredInfo>k__BackingField:
  - Key: {fileID: 2975}
    Text: "Manages everything related to doors.\n\nYou can close and destroy doors, as well as teleport to them."
  - Key: {fileID: 2337}
    Text: Any map modifiers, such as ones causing an overcharge in specified zones.
  - Key: {fileID: 2395}
    Text: Selects which filter will be applied to the door list.
  - Key: {fileID: 3046}
    Text: "Overcharges <color=#F5EB9C>Light Containment Zone</color>.\nTurns off all lights within the zone."
  - Key: {fileID: 1948}
    Text: "Overcharges <color=#CA2743>Heavy Containment Zone</color>.\nTurns off all lights within the zone."
  - Key: {fileID: 2369}
    Text: "Overcharges <color=#BCFAB2>Entrance Zone</color>.\nTurns off all lights within the zone."
  - Key: {fileID: 3909}
    Text: "Resets lights in the entire facility.\n\n<color=#A2A2A2>Setting the input field to 0 achieves the same effect.</color>"
  - Key: {fileID: 666}
    Text: "Resets locks in the entire facility.\n\n<color=#A2A2A2>Setting the input field to -1 achieves the same effect.</color>"
  - Key: {fileID: 2850}
    Text: "Overcharges <color=#9CC7F5>Surface Zone</color>.\nTurns off all lights within the zone."
  <TooltipManager>k__BackingField: {fileID: 17570}
  Closed: {fileID: 11400000, guid: e273bc2fb032c5a44a8ec33ff372414f, type: 2}
  Opened: {fileID: 11400000, guid: 3e73e452471b7f3498e1d1afc6ed399c, type: 2}
