  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“Fifteen, Twenty-two, Forty-five, Six-dash-three…hell, even Area Fourteen. More and more hits are happening and we sit here doing nothing. For what, exactly? So we know why 096 screams the way it does? So we understand why 173 shits? Shouldn't we be using what we know to fight back? To develop some kind of weapon that works?\r\n...\r\nI wonder what the O5 think.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
