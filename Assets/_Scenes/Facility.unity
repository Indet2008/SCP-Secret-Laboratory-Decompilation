  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“SCP-173 wasn’t the most peculiar anomaly in our containment. A sculpture capable of moving at high speeds when unseen. It attacks by breaking its victim’s neck. \r\n\r\nAfter its ‘mutation’, for lack of a better term, research and testing have resumed. \r\n\r\nDid the mutation make it our most peculiar anomaly?\r\nNo, I doubt it did.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
