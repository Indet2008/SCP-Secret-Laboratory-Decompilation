  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>SCP-173</b>'s physical structure has a resistance against small-arms fire with an unnatural penetration resistance. \r\n\r\nThis resistance does not apply to <b>SCP-173</b>’s Hume Shield. \r\n___\r\n\r\nAnalysis of <b>SCP-173</b>s concrete composition presents no abnormalities from normal concrete. This substance should not be as resistant as it is. As far as we can tell, it seems the anomaly possesses some ‘rejection’ of reality that prevents it from being damaged…  \r\n\r\nIf we could find a way through this ‘anti-reality’ our jobs could be easier. \r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
