  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The sound of laughter and idle chatter echoes through the hallways. An eerie silence follows. Your instincts scream at you to turn away, to ignore the familiar voices, to run in the opposite direction. \r\n\r\nA sense of unease comes over you as the voices fade into the distance.\r\n\r\nBut mankind has been known for their limitless curiosity... and the consequences that follow.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
