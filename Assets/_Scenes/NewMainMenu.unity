  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A compact 9mm personal defense weapon; the standard issue firearm for all of Site-02’s on-site security. It is highly versatile, as its collapsing stock and grip allows the weapon to be adapted to any situation.\r\nThough originally designed for its own, proprietary, armor-piercing cartridge, the guns were retrofitted to 9mm to make use of the large surplus of ammunition Site-02 has on-hand.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
