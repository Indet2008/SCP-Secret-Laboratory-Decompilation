  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '"Hi, Mark here with Ghostlight! The super-cheap and long-lasting light bulb. Ghostlight is no ordinary light bulb; its internal mechanisms only require a single non-toxic substance! No arsenic! No lead! No mercury! And best of all, its selling price is positively ethereal! Nothing beats the longevity of Ghostlight! Not even LED! Buy them once, and never worry about them dying out! Because they’re already dead!"'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
