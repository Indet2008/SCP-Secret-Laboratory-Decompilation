--- !u!114 &10553
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3376}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“The truth of the matter is, when a large catastrophe does strike our Site, all our protocols, all our drills… none of that will matter. Everything is unpredictable. Everything that can go wrong, will go wrong. It’s just a matter of time.\r\n\r\nWe are not the most well-equipped security force the Foundation has. If a large catastrophe hits, we’ll only have our wits and instincts to keep us alive.\r\n\r\nWe are the first line of defense. We are the first responders tasked to save those in danger. We have the responsibility to ensure the safety and well-being of all staff members. Because of that, you are the bravest men I have ever had the honor to serve with. ”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
