  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "SCP-049 is able to revive fallen SCP-049-2s after their death. They may revive any dead SCP-049-2 as long as that player remains as a Spectator and has not respawned. Each instance may only be revived a maximum of three times after their initial ‘cure’ and up to a total of four lives. After the SCP-049-2 player has died, the player will receive the option to remain dead.\r\n\r\nEach time an instance of SCP-049-2 is revived their maximum health is reduced. \r\n___\r\n\r<i>\nThe price you'll pay is your duty.\r\nWeather his presence and you'll see,\r\nThe crux of all your surgery.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
