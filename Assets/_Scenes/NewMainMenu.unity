  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '"I don’t remember why the cross-test between 207 and 914 was authorised — perhaps I’m not supposed to remember, and I think I know why. ’Anti-Cola’, as we''ve been calling it, has some very potent effects. Even in the most minimal amounts, extracted by means of pipettes to preserve the compound, it provided test subjects with astounding levels of regenerative abilities. We even found slow repair of damaged DNA structures and the gradual reversal of genetic disorders. In one case with a higher dosage, the Class-D was restored to life after chemical euthanasia. The implications of this are obvious — we may have found the elixir of life, and we only have one bottle."'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
