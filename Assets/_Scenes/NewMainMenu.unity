  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A specialist Insurgency sidearm, reserved only for their most accurate sharpshooters. A single shot of its .44 magnum cartridge will kill instantly with proper placement.\n\n\nIts users are well aware of this fact.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
