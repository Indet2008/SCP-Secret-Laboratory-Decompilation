  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '“So far, this newest iteration of the Micro H.I.D. has been a massive improvement, being around four times more efficient than the previous model, with investigations into possible refinements currently underway. I am hoping this will shine a light on how we could develop Project: Segmentum more efficiently — with more and more anomaly termination requests being accepted, I admit that we could use more firepower in order to comply with  the E.P.C.”'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
