  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "By holding C, SCP-939 adopts a low-to-the ground pose, allowing them to greatly increase its perception of their surroundings. While focusing, SCP-939 gains the following benefits:\r\n\r\nA new ability: ‘<b><i>Lunge</i></b>’.\r\n• The range of <i>‘Ultrasensitive’</i> is greatly increased over several seconds.\r\n • Humans visible under the effects of <i>‘Ultrasensitive’</i> are recoloured to their class color, e.g.: Class-D will be perceived as <color=\"orange>orange</color>. \r\n • Players under the effects of SCP-268 will become visible.\r\n\r\nFocus has several drawbacks. SCP-939 can only partially rotate its head and cannot move for several seconds after Focus is deactivated.  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
