  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A prototype ontokinergy-based weapon further developed by Site-02, capable of reducing any target down to its basic atoms in a matter of seconds. The 3-X Particle Disruptor is equipped with two firing modes: a short burst of energy, and a powerful beam. The energy is powerful enough to disintegrate matter at a molecular level, leaving no trace behind.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
