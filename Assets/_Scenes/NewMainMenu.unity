      m_Calls: []
  m_text: "A pair of earthenware jars of Tunisian origin; skillfully handcrafted by masters of pottery. The motifs that cover them are imbued with generations of rich culture. The warmth of that far land almost reaches out to you.\n\n\nYet, it feels cold here.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
