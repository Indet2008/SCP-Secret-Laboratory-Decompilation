  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“Doctors, researchers, engineers, you name it. The Foundation is made of multiple individuals, each bringing their set of skills and abilities to the fore.\r\n\r\nEach specially trained in their division, our staff help us stand in the darkness. To fight it, contain it, and shield it from the public eye. So that everyone else can live in a sane and normal world.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
