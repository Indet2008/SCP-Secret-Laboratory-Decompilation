  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "While unobserved, press the Attack button to perform Snap on a human, killing them immediately. \r\n___\r\n\r\nSCP-173 has been seen attacking subjects from behind. It attacks by snapping the neck at the base of the skull.\r\nThe attack is carried out at a high speed, resulting in a severe and unnatural rotation of the spine; this is a minimum of 180 degrees.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
