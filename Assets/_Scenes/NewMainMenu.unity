  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“It’s a new production for the task forces. Executive order, straight from the top. The exact reasonings for the request are classified, the specifics are only known by the higher-ups. All that we know is that it’s something about wanting to increase the amount of firepower that each squad is capable of. \r\n\r\nI’ve heard rumors that it’s because of a mission gone wrong, some disaster that the brass felt could’ve been solved by more firepower. Others say that we’re equipping the squads with more firepower in preparation to move further with the EPC. A handful say that it’s just an order for new guns and we need to stop overthinking it. \r\n\t\t\t\t\t\t\r\nWhatever. I’m not paid to think of stuff like this, I’m paid to build guns. So, if that’s all the questions you have for me, I have machine guns to assemble.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
