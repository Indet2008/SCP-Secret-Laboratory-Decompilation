  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A powerful LMG, issued in small numbers by the Insurgency. With the remarkable ability to lay down suppressive fire, this 7.62x39 LMG can prove a valuable asset to an Insurgency squad.\r\n\r\nEvident by how infrequently it’s used, the Insurgency only has a small number of them in their possession.\r\n\r\nThis remains an assumption.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
