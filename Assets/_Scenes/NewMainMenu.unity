  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "SCP-939 swings its claws in a wide arc, dealing moderate area damage with a short cooldown. Claw has armor penetration, meaning armored targets will take less damage compared to those who are unprotected. \r\n\r\n___\r\n\r<i>\n“Claws as sharp as a sword, teeth longer than daggers. How is it that a human can be turned from harmless to a predator capable of mindless slaughter? This world can be truly terrifying.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4294506744
