      m_Calls: []
  m_text: "A mere concrete sculpture upon first glance; an art piece to be seen and admired. \r\n\r\n\r\nOn second glance, you’ll notice it’s somehow closer, as if yearning for attention.\r\n\r\nThere is no third glance. You’re dead by then.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
