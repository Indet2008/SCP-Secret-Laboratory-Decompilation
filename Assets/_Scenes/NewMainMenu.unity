      m_Calls: []
  m_text: "Press the Tab button to open up the Hunter’s Atlas: a small map displaying all rooms within a large radius of SCP-106. Clicking on any of the rooms will cause SCP-106 to immediately teleport to them, at the cost of Vigor. \r\n___\r\n\r<i>\n…The old man felt a sense of nostalgia, as he wandered around the many halls, reminding him of a place he once knew…\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
