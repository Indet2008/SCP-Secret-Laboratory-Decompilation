  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A specialist Insurgency shotgun. The weapon is 12-gauge, double-barrelled, and high-capacity. Its users work in a quick, yet calculated, and efficient manner — they incapacitate, execute, and move on to the next target.\r\n\r\nIt is often found that Foundation psychologists need to treat even the more experienced guards. It is claimed that sometimes, in some distant hallway, they still hear the weapon being cycled.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
