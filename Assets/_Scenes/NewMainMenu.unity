  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "“It is not every day that you see an SCP object break the laws of thermodynamics. It’s probably the most unpopular law to flout. Most SCP objects break other laws of physics… or just laws in general, I suppose.\r\n\r\nPersonally, I don’t agree with its current containment procedures. It’s locked in one of our No. 7-type Bulletproof lockers… one slight shake and that thing starts rolling around and bouncing.”\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
