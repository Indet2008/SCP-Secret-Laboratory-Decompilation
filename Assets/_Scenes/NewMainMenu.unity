  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A tall, pale humanoid capable of tearing through waves of heavily armed forces. It cries and cries and never seems content. \r\n\r\nYou wish you could comfort it. \r\n\r\nYou wish someone had told you to close your eyes.\r\n\r\nYou wish you knew the danger you were in when the crying finally stopped."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b40e27b94d22bbf4d8ed598c1c3f329b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 03c51d5289a83a84f80bbf2ab954cca7, type: 2}
