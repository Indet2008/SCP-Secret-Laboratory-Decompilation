  m_Name:
  m_EditorClassIdentifier:
  _englishVersion: Allow the game to capture your microphone and transmit it to users when push-to-talk keys are held. A microphone icon will be displayed at the bottom of the screen, indicating active transmission. The game will never transmit, or use your microphone without the indicator being visible.
  _fileId: 4
  _line: 13
